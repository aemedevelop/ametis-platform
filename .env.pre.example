# AMETIS Platform - Pre (validacion de testers antes de Pro)
#
# Copiar como `.env.pre` en el VPS (mismo servidor que produccion) y
# completar secretos reales. No subir `.env.pre` a Git.
#
# Este entorno vive en el MISMO VPS que produccion, pero completamente
# aislado: contenedores con prefijo "ametis-pre-", red Docker propia,
# Postgres propio, Keycloak propio, MinIO propio. Nada se comparte con
# `.env.vps` salvo la maquina fisica.

# Aislamiento del stack (ver infra/docker-compose.yml e infra/platform-stack.compose.yml)
CONTAINER_PREFIX=ametis-pre
DOCKER_NETWORK=ametis_internal_pre
IMAGE_TAG=pre
# Activa el servicio "postgres" propio del compose (perfil apagado por defecto,
# produccion no lo usa porque tiene su propio Postgres externo al stack).
COMPOSE_PROFILES=local-db

# Carpeta raiz de Google Drive EXCLUSIVA de pre. Nunca reutilizar la de
# produccion ni la de local -- ver docs/vps-produccion-ametis.md.
AGENT_FACTORY_GOOGLE_ROOT_FOLDER_ID=<pre-google-drive-root-folder-id>
AGENT_FACTORY_GOOGLE_AUTH_MODE=workspace-oauth
AGENT_FACTORY_GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
AGENT_FACTORY_GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
AGENT_FACTORY_GOOGLE_OAUTH_REDIRECT_URI=https://ametis.pre.api.aemetech.com/api/agent-factory/drive/oauth/callback
AGENT_FACTORY_GOOGLE_FRONTEND_RETURN_URI=https://ametis.pre.agent-factory.aemetech.com
AGENT_FACTORY_GOOGLE_TOKEN_ENCRYPTION_KEY=
AGENT_FACTORY_GOOGLE_CREDENTIALS_HOST_FILE=../../ametis-ai-pre/docker/compose/rag/secrets/google-drive-service-account.json

# Puertos: mismo bloque que produccion +1000, para que ambos stacks convivan
# en el mismo VPS sin chocar.
PLATFORM_POSTGRES_PORT=6433
KONG_PROXY_PORT=9440
KONG_PROXY_TLS_PORT=9443
KONG_ADMIN_PORT=9441
KEYCLOAK_PORT=9081
CORE_API_PORT=9090
HUB_WEB_PORT=4010
AGENT_FACTORY_WEB_PORT=4200
AGENT_FACTORY_API_PORT=9083
MINIO_API_PORT=10000
MINIO_CONSOLE_PORT=10001

HUB_API_BASE_URL=https://ametis.pre.api.aemetech.com
HUB_WEB_URL=https://ametis.pre.hub.aemetech.com
AGENT_FACTORY_WEB_URL=https://ametis.pre.agent-factory.aemetech.com
AGENT_FACTORY_PUBLIC_API_URL=https://ametis.pre.api.aemetech.com
KEYCLOAK_HOSTNAME=https://ametis.pre.auth.aemetech.com
KEYCLOAK_AUTH_URL=https://ametis.pre.auth.aemetech.com/realms/ametis/protocol/openid-connect/auth
CORE_JWT_ISSUER=https://ametis.pre.auth.aemetech.com/realms/ametis
AGENT_FACTORY_JWT_ISSUER=https://ametis.pre.auth.aemetech.com/realms/ametis

# Nombres internos: iguales a produccion a proposito (mismos alias de red),
# solo resuelven distinto porque viven en la red ametis_internal_pre.
AGENT_FACTORY_CORE_BASE_URL=http://kong:8000
NEWSLETTER_CORE_BASE_URL=http://kong:8000
AUTH_KEYCLOAK_BASE_URL=http://keycloak:8080
AGENT_FACTORY_JWT_JWK_SET_URI=http://keycloak:8080/realms/ametis/protocol/openid-connect/certs
CORE_JWT_JWK_SET_URI=http://keycloak:8080/realms/ametis/protocol/openid-connect/certs
AGENT_FACTORY_AMETIS_AI_RAG_BASE_URL=http://rag-service:8000
RAG_CHAT_API_URL=http://rag-service:8000/tenants/aeme/agents/support_agent/knowledge-bases/landing/query

HUB_KEYCLOAK_CLIENT_ID=ametis-hub-web
NEWSLETTER_KEYCLOAK_CLIENT_ID=newsletter-web
AGENT_FACTORY_KEYCLOAK_CLIENT_ID=agent-factory-web

CORE_CORS_ALLOWED_ORIGIN_PATTERNS=https://ametis.pre.hub.aemetech.com,https://ametis.pre.agent-factory.aemetech.com
AGENT_FACTORY_CORS_ALLOWED_ORIGIN_PATTERNS=https://ametis.pre.hub.aemetech.com,https://ametis.pre.agent-factory.aemetech.com

# Postgres propio de pre (servicio "postgres" activado por COMPOSE_PROFILES
# arriba). LOCAL_DB_ADMIN_* es el superusuario del contenedor; los usuarios
# de aplicacion (keycloak_db, core_db, agent_factory_db) los crea
# db/postgres/01-init-databases.sql con sus contrasenas propias -- si se
# quiere reforzar, cambiarlas ahi antes del primer arranque de este stack
# (el script solo corre una vez, en un volumen nuevo).
LOCAL_DB_ADMIN_USER=postgres
LOCAL_DB_ADMIN_PASSWORD=<pre-postgres-admin-password>
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=<pre-postgres-admin-password>
KEYCLOAK_ADMIN_PASSWORD=<pre-keycloak-admin-password>
CORE_DB_URL=jdbc:postgresql://postgres:5432/core_db?currentSchema=core
CORE_DB_USERNAME=core_user
CORE_DB_PASSWORD=core_pass
AUTH_KEYCLOAK_CLIENT_SECRET=<pre-core-api-client-secret>
AGENT_FACTORY_DB_URL=jdbc:postgresql://postgres:5432/agent_factory_db
AGENT_FACTORY_DB_USER=agent_factory_user
AGENT_FACTORY_DB_PASSWORD=agent_factory_pass

# Base publica de los canales de despliegue (a traves de Kong / dominio pre)
AGENT_FACTORY_PUBLIC_BASE_URL=https://ametis.pre.api.aemetech.com/api/agent-factory/public
AGENT_FACTORY_PUBLIC_WIDGET_URL=https://ametis.pre.api.aemetech.com/api/agent-factory/public/widget.js

# Almacenamiento: MinIO por defecto en pre (validar aqui antes de decidir
# cuando migrar Pro). Instancia propia (servicio "minio" de este mismo
# compose, aislada en ametis_internal_pre) -- no la de produccion.
AGENT_FACTORY_STORAGE_PROVIDER=minio
AGENT_FACTORY_MINIO_ENDPOINT=http://minio:9000
AGENT_FACTORY_MINIO_ACCESS_KEY=<pre-minio-access-key>
AGENT_FACTORY_MINIO_SECRET_KEY=<pre-minio-secret-key>
AGENT_FACTORY_MINIO_BUCKET_PREFIX=af-pre-
AGENT_FACTORY_MINIO_SECURE=false
