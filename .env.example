AGENT_FACTORY_GOOGLE_ROOT_FOLDER_ID=<google-drive-root-folder-id>
AGENT_FACTORY_GOOGLE_AUTH_MODE=workspace-oauth
AGENT_FACTORY_GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
AGENT_FACTORY_GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
# Debe apuntar al dominio publico que enruta /api/agent-factory hacia Kong/backend.
AGENT_FACTORY_GOOGLE_OAUTH_REDIRECT_URI=https://ametis.api.aemetech.com/api/agent-factory/drive/oauth/callback
AGENT_FACTORY_GOOGLE_FRONTEND_RETURN_URI=https://ametis.agent-factory.aemetech.com
# Optional: 32 random bytes encoded as Base64. If omitted, the OAuth client secret derives the encryption key.
AGENT_FACTORY_GOOGLE_TOKEN_ENCRYPTION_KEY=
AGENT_FACTORY_GOOGLE_CREDENTIALS_HOST_FILE=../../ametis-ai/docker/compose/rag/secrets/google-drive-service-account.json
PLATFORM_POSTGRES_PORT=5433
KONG_PROXY_PORT=8440
KONG_PROXY_TLS_PORT=8443
KONG_ADMIN_PORT=8441
KEYCLOAK_PORT=8081
CORE_API_PORT=8090
HUB_WEB_PORT=3010
AGENT_FACTORY_WEB_PORT=3200
AGENT_FACTORY_API_PORT=8083

# Public HTTPS URLs used by browsers.
HUB_API_BASE_URL=https://ametis.api.aemetech.com
HUB_WEB_URL=https://ametis.hub.aemetech.com
AGENT_FACTORY_WEB_URL=https://ametis.agent-factory.aemetech.com
AGENT_FACTORY_PUBLIC_API_URL=https://ametis.api.aemetech.com
KEYCLOAK_HOSTNAME=https://ametis.auth.aemetech.com
KEYCLOAK_AUTH_URL=https://ametis.auth.aemetech.com/realms/ametis/protocol/openid-connect/auth
CORE_JWT_ISSUER=https://ametis.auth.aemetech.com/realms/ametis
AGENT_FACTORY_JWT_ISSUER=https://ametis.auth.aemetech.com/realms/ametis

# Internal Docker URLs. Do not use host ports here.
AGENT_FACTORY_CORE_BASE_URL=http://kong:8000
NEWSLETTER_CORE_BASE_URL=http://kong:8000
AUTH_KEYCLOAK_BASE_URL=http://keycloak:8080
AGENT_FACTORY_JWT_JWK_SET_URI=http://keycloak:8080/realms/ametis/protocol/openid-connect/certs
CORE_JWT_JWK_SET_URI=http://keycloak:8080/realms/ametis/protocol/openid-connect/certs
AGENT_FACTORY_AMETIS_AI_RAG_BASE_URL=http://rag-service:8000
RAG_CHAT_API_URL=http://rag-service:8000/tenants/aeme/agents/support_agent/knowledge-bases/landing/query

HUB_KEYCLOAK_CLIENT_ID=ametis-hub-web
NEWSLETTER_KEYCLOAK_CLIENT_ID=newsletter-web
AGENT_FACTORY_KEYCLOAK_CLIENT_ID=agent-factory-web

CORE_CORS_ALLOWED_ORIGIN_PATTERNS=https://ametis.hub.aemetech.com,https://ametis.agent-factory.aemetech.com
AGENT_FACTORY_CORS_ALLOWED_ORIGIN_PATTERNS=https://ametis.hub.aemetech.com,https://ametis.agent-factory.aemetech.com

# PostgreSQL compartido VPS
PLATFORM_DATABASE_HOST=<postgres-host>
PLATFORM_DATABASE_PORT=5432
KEYCLOAK_DB_URL=jdbc:postgresql://<postgres-host>:5432/keycloak_db
KEYCLOAK_DB_USERNAME=<keycloak-db-user>
KEYCLOAK_DB_PASSWORD=<keycloak-db-password>
KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>
CORE_DB_URL=jdbc:postgresql://<postgres-host>:5432/core_db?currentSchema=core
CORE_DB_USERNAME=core_user
CORE_DB_PASSWORD=<core-db-password>
AUTH_KEYCLOAK_CLIENT_SECRET=<core-api-client-secret>
AGENT_FACTORY_DB_URL=jdbc:postgresql://<postgres-host>:5432/agent_factory_db
AGENT_FACTORY_DB_USER=agent_factory_user
AGENT_FACTORY_DB_PASSWORD=<agent-factory-db-password>

# Base publica de los canales de despliegue (a traves de Kong)
AGENT_FACTORY_PUBLIC_BASE_URL=http://localhost:8440/api/agent-factory/public
AGENT_FACTORY_PUBLIC_WIDGET_URL=http://localhost:8440/api/agent-factory/public/widget.js
