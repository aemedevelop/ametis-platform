{
  "name": "ametis-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Widget de chat embebible para despliegues públicos de AMETIS Agent Factory.",
  "scripts": {
    "build": "esbuild src/widget.ts --bundle --minify --format=iife --target=es2018 --outfile=dist/ametis-widget.js",
    "build:copy": "npm run build && node scripts/copy-to-backend.js",
    "watch": "esbuild src/widget.ts --bundle --format=iife --target=es2018 --outfile=dist/ametis-widget.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
